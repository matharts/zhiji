---
import Cosmos from '../components/Cosmos.astro';
import Icon from '../components/Icon.astro';
import SceneArt from '../components/site/SceneArt.astro';
import '../styles/global.css';
import '../styles/zhiji.css';
import '../styles/scene.css';

interface Props {
  preview?: boolean;
}

const { preview = false } = Astro.props;
const repository = 'https://github.com/matharts/zhiji';
const platforms = [
  { id: 'macos', name: 'macOS', icon: 'laptop' },
  { id: 'windows', name: 'Windows', icon: 'window-grid' },
  { id: 'linux', name: 'Linux', icon: 'terminal' },
] as const;
const features = [
  { id: 'input', name: '取数与校时' },
  { id: 'flight', name: '飞宫与自化' },
  { id: 'annotation', name: '标注与复盘' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07060c" />
    {preview && <meta name="robots" content="noindex" />}
    <meta name="description" content="知几是面向命理师的开源紫微斗数专业排盘软件，支持取数校时、飞宫自化、盘面标注与导出。" />
    <link rel="icon" href="/images/app.ico" />
    <title>知几 — 紫微斗数专业排盘软件</title>
  </head>
  <body>
    <Cosmos />
    <a class="skip-link" href="#main">跳至正文</a>
    <div class="screen mx-auto grid min-h-svh max-w-[100rem] grid-rows-[auto_1fr_auto]">
      <header class="screen-header flex items-center justify-between gap-4">
        <a class="screen-brand screen-icon grid size-11 place-items-center" href="/" aria-label="知几首页" aria-current={preview ? undefined : 'page'}>
          <img src="/images/app.png" width="32" height="32" alt="" />
        </a>
        <nav class="flex items-center gap-6 sm:gap-9" aria-label="主导航">
          <a class="screen-link" href="/guide/"><Icon name="book-open" /> 使用指南</a>
          <a class="screen-link" href={repository}><Icon name="code" /> GitHub</a>
        </nav>
      </header>

      <main class="screen-main relative grid items-center" id="main" tabindex="-1" aria-labelledby="screen-title">
        <div class="screen-copy relative z-10">
          <h1 id="screen-title">知几</h1>
          <p class="screen-subtitle">紫微斗数专业排盘软件</p>
          <div class="screen-actions flex flex-wrap items-center gap-x-6 gap-y-2">
            <a class="screen-primary inline-flex items-center justify-between gap-6" href="/experience/#workspace">体验参考盘 <Icon name="arrow-right" /></a>
            <a class="screen-link" href="/download/" data-download hidden>下载知几 <Icon name="download" /></a>
          </div>
          <nav class="screen-platforms flex flex-wrap items-center gap-x-4" aria-label="按桌面系统下载" data-download hidden>
            {platforms.map(({ id, name, icon }) => (
              <a class="screen-link" href={`/download/#platform-${id}`} data-download={id} hidden><Icon name={icon} /> {name}</a>
            ))}
          </nav>
        </div>
        <div class="screen-stage pointer-events-none relative self-stretch" data-centered-scene>
          <SceneArt />
        </div>
      </main>

      <footer class="screen-footer flex flex-row-reverse flex-wrap items-center justify-between gap-x-8">
        <div class="screen-controls flex items-center gap-1" role="group" aria-label="天地人三盘动画">
          <span>天地人三盘</span>
          <button class="screen-icon grid size-11 place-items-center" type="button" data-scene-replay aria-label="重播动画" title="重播动画" hidden><Icon name="replay" /></button>
        </div>
        <nav class="screen-features flex flex-wrap items-center gap-x-5 sm:gap-x-8" aria-label="了解产品功能">
          {features.map(({ id, name }) => <a class="screen-link" href={`/features/#${id}`}>{name}</a>)}
        </nav>
      </footer>
    </div>
    <script>
      import { loadReleaseLinks } from '../scripts/release-links.ts';
      import { mountScene } from '../scripts/scene.ts';

      void loadReleaseLinks();
      const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
      let revision = 0;
      // 首次挂载前使用空回调，使离页与切换动效偏好共用清理入口。
      let disposeScene = () => {};

      /** 取消待完成的挂载，并释放已经启用的场景。 */
      function removeScene() {
        revision += 1;
        disposeScene();
        disposeScene = () => {};
      }

      /** 动效偏好变化后重新挂载，丢弃在此期间返回的旧场景。 */
      async function updateScene() {
        removeScene();
        if (motionPreference.matches) return;
        const requested = revision;
        const dispose = await mountScene();
        if (requested === revision) disposeScene = dispose;
        else dispose();
      }

      motionPreference.addEventListener('change', updateScene);
      window.addEventListener('pagehide', removeScene);
      window.addEventListener('pageshow', (event) => {
        if (event.persisted) void updateScene();
      });
      void updateScene();
    </script>
  </body>
</html>

<style>
  .screen {
    --screen-gutter: clamp(20px, 5.3vw, 88px);
    --screen-copy: #cbc0d9;
    padding-inline: var(--screen-gutter);
  }
  .screen-header { min-height: 80px; }
  .screen-brand { margin-inline-start: -6px; }
  .screen-brand img { border-radius: 8px; }
  .screen-header nav { color: #e3d9ee; }
  .screen-main { grid-template-columns: minmax(0, .74fr) minmax(0, 1.26fr); }
  .screen-copy { padding-block: 28px; }
  .screen-copy h1 {
    font: 600 clamp(64px, 8.2vw, 96px)/1.08 var(--display-font);
    letter-spacing: -.035em;
    color: #faf6ff;
  }
  .screen-subtitle {
    margin-top: 0.7em;
    color: #e8dff2;
    font-size: clamp(17px, 1.8vw, 25px);
    font-weight: 500;
    line-height: 1.5;
  }
  .screen-actions { margin-top: clamp(22px, 3.2vw, 45px); }
  .screen-primary {
    min-height: 51px;
    padding-inline: 16px;
    border-radius: 7px;
    background: #eee7f9;
    color: #191124;
    font-size: 14px;
    font-weight: 650;
    transition: background-color 160ms ease;
  }
  .screen-primary:hover { background: #fffaff; }
  .screen-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 13px;
    white-space: nowrap;
    text-underline-offset: 4px;
  }
  .screen-link:hover { color: #fffaff; text-decoration: underline; }
  .screen-link :global(.ui-icon), .screen-primary :global(.ui-icon), .screen-icon :global(.ui-icon) {
    width: 16px;
    height: 16px;
  }
  .screen-link :global(.ui-icon) { color: #bfb0d8; }
  .screen-link:hover :global(.ui-icon) { color: inherit; }
  .screen-platforms { margin-top: 3px; color: var(--screen-copy); }
  .screen-platforms .screen-link { font-size: 12px; }
  .screen-stage { min-height: 310px; margin: -18px calc(-.68 * var(--screen-gutter)) -18px -7rem; }
  /* 静态参考盘与实时场景共用中心，适配窄视口及减少动态效果。 */
  .screen-stage :global(.poster-chart) {
    inset: 50% auto auto 50%;
    width: min(72%, 66svh, 440px);
    gap: 3px;
    transform: translate(-50%, -50%) perspective(900px) rotateX(24deg) rotateZ(-8deg);
  }
  .screen-stage :global(.poster-cell) { padding: clamp(4px, .8vw, 11px); border: 0; }
  .screen-stage :global(.poster-cell strong) { margin-top: clamp(4px, 1vw, 12px); }
  .screen-stage :global(.poster-center) { gap: 8px; }
  .screen-stage :global(.poster-center > div) { gap: 5px 12px; }
  .screen-footer { min-height: 72px; color: var(--screen-copy); }
  .screen-controls { margin-inline-end: -7px; font-size: 12px; }
  .screen-controls > span { margin-inline-end: 3px; }
  .screen-icon { border-radius: 6px; }
  .screen-icon:hover { color: #fff; background-color: #e8d6ff13; }

  @media (width < 768px) {
    .screen-header { min-height: 62px; }
    .screen-main { grid-template-columns: 1fr; grid-template-rows: auto minmax(240px, 1fr); }
    .screen-copy { padding-block: clamp(18px, 4.5svh, 40px) 0; }
    .screen-copy h1 { font-size: clamp(52px, 14vw, 76px); }
    .screen-actions { margin-top: 19px; }
    .screen-stage { min-height: 240px; margin: 0 calc(-1 * var(--screen-gutter)); }
    .screen-stage :global(.poster-chart) { width: min(67vw, 38svh, 292px); gap: 2px; }
    .screen-stage :global(.poster-cell), .screen-stage :global(.poster-center) { font-size: 8px; }
    .screen-stage :global(.poster-cell strong) { font-size: 9px; }
    .screen-stage :global(.poster-center > div) { gap: 4px 7px; }
    .screen-footer { min-height: 56px; }
  }
  @media (width < 580px) {
    .screen-footer { display: grid; justify-content: stretch; padding-bottom: 8px; }
    .screen-controls { justify-self: end; min-height: 34px; }
    .screen-features { justify-content: space-between; }
  }
</style>
