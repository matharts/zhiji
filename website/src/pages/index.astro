---
import BaseLayout from '../layouts/BaseLayout.astro';
import SceneArt from '../components/site/SceneArt.astro';
import WorkspaceStory from '../components/site/WorkspaceStory.astro';
import DesktopTools from '../components/site/DesktopTools.astro';
import BeforeDownload from '../components/site/BeforeDownload.astro';
import BirthWorkflow from '../components/site/BirthWorkflow.astro';
import SelfTransformation from '../components/site/SelfTransformation.astro';
import Icon from '../components/Icon.astro';
import '../styles/reference-home.css';
import '../styles/product-stories.css';
import '../styles/workspace-story.css';
---
<BaseLayout title="知几 — 紫微斗数专业排盘软件" description="知几是面向命理师的紫微斗数桌面排盘软件，支持日期取数与校时、飞宫四化、盘面标注、草稿保存与 PNG 导出。">
 <main id="main" class="launch-page reference-home">
  <section class="hero ray-hero relative overflow-hidden" aria-labelledby="hero-title">
   <div class="hero-intro wrap">
    <div class="hero-copy">
     <h1 id="hero-title">紫微斗数<br />专业排盘</h1>
     <p>知几是面向命理师的桌面排盘软件。<br />点选宫位，查看禄、权、科、忌的落点。</p>
     <div class="hero-primary-actions"><a class="action" href="/download/">下载知几 <Icon name="arrow-down" /></a><a class="hero-demo-link" href="#exhibit-flight">体验飞宫四化 <Icon name="arrow-right" /></a></div>
     <p class="hero-release" data-release-summary role="status" aria-live="polite">查看版本与平台信息</p>
     <nav class="hero-platforms" aria-label="桌面平台"><a href="/download/#platform-macos">macOS</a><span aria-hidden="true">/</span><a href="/download/#platform-windows">Windows</a><span aria-hidden="true">/</span><a href="/download/#platform-linux">Linux</a></nav>
    </div>
   </div>
   <div class="hero-scene" data-centered-scene><SceneArt /></div>
   <div class="hero-bottom wrap">
    <a class="hero-explore" href="#workspace"><span>查看工作流程</span><Icon name="arrow-down" /></a>
    <div class="ray-hero-caption"><span>天地人三盘 · 飞化示意</span><button class="motion-toggle" type="button" data-scene-replay hidden aria-label="重播混沌开场" title="重播混沌开场"><Icon name="replay" /></button><button class="motion-toggle" type="button" data-motion-toggle hidden><span class="motion-icon" data-motion-icon data-state="playing" aria-hidden="true"><Icon name="pause" class="motion-pause" /><Icon name="play" class="motion-play" /></span><span data-motion-label>暂停动画</span></button></div>
   </div>
  </section>

  <nav class="product-outline wrap" aria-label="产品章节">{[{id:'workspace',name:'完整工作区'},{id:'self-transformations',name:'向心与离心'},{id:'date-workflow',name:'取数与校时'},{id:'annotation',name:'盘面标注'},{id:'save-and-export',name:'保存与导出'}].map(item=><a href={`#${item.id}`}>{item.name}<Icon name="arrow-down-right" /></a>)}</nav>

  <WorkspaceStory />

  <SelfTransformation />
  <BirthWorkflow />

  <DesktopTools />

  <section class="ray-resources wrap" aria-labelledby="resources-title"><div class="ray-section-head"><div><h2 id="resources-title">让下一次使用，更顺手。</h2><p>操作指南、版本记录和问题反馈。</p></div></div><div class="resource-pair"><a href="/guide/"><div class="resource-glyph" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 4h6c2 0 2 1 2 2v15c0-2-1-3-3-3H4zM20 4h-6c-2 0-2 1-2 2v15c0-2 1-3 3-3h5z"/></svg></div><div><h3>使用指南</h3><p>从起盘到保存，按任务查阅操作。</p></div><Icon name="arrow-up-right" /></a><a href="https://github.com/matharts/zhiji/releases"><div class="resource-glyph" aria-hidden="true"><Icon name="replay" /></div><div><h3>版本记录</h3><p>查看实际发布版本与更新内容。</p></div><Icon name="arrow-up-right" /></a></div><div class="resource-links"><a href="/guide/#start">开始一张命盘 <Icon name="arrow-right" /></a><a href="/guide/#shortcuts">查看全部快捷键 <Icon name="arrow-right" /></a><a href="https://github.com/matharts/zhiji/issues">反馈使用问题 <Icon name="arrow-up-right" /></a></div></section>

  <BeforeDownload />

  <section class="ray-download wrap" aria-labelledby="download-title"><img src="/images/app.png" alt="" width="64" height="64" /><h2 id="download-title">开始使用知几。</h2><p>紫微斗数专业排盘软件。</p><a class="action" href="/download/">下载知几 <Icon name="arrow-down" /></a><nav aria-label="选择下载平台"><a href="/download/#platform-macos">macOS</a><a href="/download/#platform-windows">Windows</a><a href="/download/#platform-linux">Linux</a></nav><p class="hero-release" data-release-summary role="status" aria-live="polite">查看版本与平台信息</p></section>
 </main>
 <script>import '../scripts/home.ts'; import '../scripts/launch.ts'; import '../scripts/product-stories.ts'; import '../scripts/workspace-story.ts';</script>
</BaseLayout>
