---
import SingleScreenLayout from '../layouts/SingleScreenLayout.astro';
---
<SingleScreenLayout />
<script>
  // 完整版迁移后，已分享的首页章节链接仍可直达原来的内容。
  const experienceAnchors = [
    '#workspace', '#exhibit-flight', '#chart-reading', '#self-transformations',
    '#chart-annotation', '#chart-outputs', '#annotation', '#save-and-export',
    '#date-workflow', '#desktop-tools-title', '#resources-title',
  ];
  if (experienceAnchors.includes(window.location.hash)) {
    window.location.replace(`/experience/${window.location.search}${window.location.hash}`);
  }
</script>
