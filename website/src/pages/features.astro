---
import ProductLayout from '../layouts/ProductLayout.astro';
import Icon from '../components/Icon.astro';
import { productFeatures } from '../data/product.ts';
import '../styles/product-documents.css';

const groups = [
  { title: '起盘', ids: ['input'] },
  { title: '看盘', ids: ['chart', 'flight'] },
  { title: '留存', ids: ['annotation', 'draft', 'export'] },
  { title: '桌面', ids: ['workspace', 'support'] },
].map(group => ({ ...group, features: productFeatures.filter(feature => group.ids.includes(feature.id)) }));
---
<ProductLayout title="功能 — 知几" description="了解知几的取数校时、盘面显示、飞宫自化、标注与草稿功能。">
  <main id="main" class="product-document product-wrap features-document">
    <header class="document-title">
      <h1>功能</h1>
      <div><p>从出生资料取数，到飞化、盘面标注和文件留存。</p><a class="product-link" href="/#exhibit-flight">打开四化演示 <Icon name="arrow-up-right" /></a></div>
    </header>
    <div class="document-layout">
      <nav class="document-nav" aria-label="功能目录">
        {groups.flatMap(({ features }) => features.map(feature => <a href={`#${feature.id}`}>{feature.title}</a>))}
      </nav>
      <div class="document-content">
        <div class="feature-groups">
        {groups.map(({ title, features }) => (
          <div class="function-group">
            <h2>{title}</h2>
            {features.map(feature => (
              <section id={feature.id} class="function-item" aria-labelledby={`${feature.id}-title`}>
                <div class="function-item-heading">
                  <h3 id={`${feature.id}-title`}>{feature.title}</h3>
                  <a class="product-link" href={`/guide/#${feature.guide}`}>操作方法 <Icon name="arrow-up-right" /></a>
                </div>
                <ul>{feature.items.map(item => <li>{item}</li>)}</ul>
              </section>
            ))}
          </div>
        ))}
        </div>
        <div class="document-end"><p>适用于 macOS、Windows 和 Linux。</p><a class="product-primary" href="/download/">下载知几 <Icon name="arrow-down" /></a></div>
      </div>
    </div>
  </main>
</ProductLayout>
