---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { productFeatures } from '../data/product.ts';
import DownloadClose from '../components/site/DownloadClose.astro';
import FeatureVisual from '../components/site/FeatureVisual.astro';
import '../styles/features-page.css';
// 关键机制配图，辅助主题使用紧凑条目；不为每项能力再套一层卡片。
const visuals = { input:'input', chart:'chart', annotation:'annotation', draft:'files', workspace:'settings' } as const;
---
<BaseLayout title="功能总览 — 知几" description="了解知几的八个功能主题：取数、盘面、飞化、标注、草稿、图片、桌面习惯与帮助。">
 <main id="main" class="reference-page features-page">
  <header class="reference-intro wrap"><h1>一张命盘，完整的工作方式。</h1><p>从资料取数，到观察、记录和留存。</p><a class="text-link" href="/#workspace">先看完整工作区演示 <Icon name="arrow-right" /></a></header>
  <div class="reference-layout wrap">
   <nav class="reference-nav" aria-label="功能主题">{productFeatures.map(feature=><a href={`#${feature.id}`}>{feature.title}</a>)}</nav>
   <div class="reference-body">{productFeatures.map(feature=>{
    const kind = visuals[feature.id as keyof typeof visuals];
    return <section id={feature.id} class:list={['feature-proof',{'feature-proof-compact':!kind}]}>
     <div class="feature-proof-copy"><h2>{feature.title}</h2><p class="reference-summary">{feature.summary}</p><ul>{feature.items.map(item=><li>{item}</li>)}</ul><a class="text-link" href={`/guide/#${feature.guide}`}>查看使用方法 <Icon name="arrow-up-right" /></a></div>
     {kind&&<figure class="feature-proof-visual" aria-label={`${feature.title}功能示意`}><FeatureVisual kind={kind} /></figure>}
    </section>;
   })}</div>
  </div><DownloadClose />
 </main>
</BaseLayout>
