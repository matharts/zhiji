---
import BaseLayout from '../layouts/BaseLayout.astro';
import SceneHero from '../components/site/SceneHero.astro';
import FeatureVisual from '../components/site/FeatureVisual.astro';
import Icon from '../components/Icon.astro';
import { productFeatures } from '../data/product.ts';
---
<BaseLayout title="知几 — 产品、下载与使用指南" description="知几产品门户。了解功能、下载桌面版、阅读使用指南，找到紫微斗数研习所需的工具。">
 <main id="main" class="portal-page"><SceneHero mode="portal" />
  <nav class="portal-launchpad wrap" aria-label="快速开始"><a href="/download/"><strong>下载桌面版</strong><span>选择适合电脑的版本</span><Icon name="arrow-down" /></a><a href="/guide/"><strong>开始第一张盘</strong><span>从取数到保存的操作说明</span><Icon name="arrow-right" /></a><a href="/#exhibit-flight"><strong>试一试飞宫</strong><span>直接操作固定示例</span><Icon name="arrow-up-right" /></a></nav>
  <section class="portal-features wrap"><div class="directory-heading"><h2>找到你的工作入口。</h2><a class="text-link" href="/features/">查看全部功能 <Icon name="arrow-right" /></a></div><div class="portal-mosaic">
   <a class="portal-main-feature" href="/features/#input"><div><h3>从资料到命盘。</h3><p>公历、农历、干支反推。<br />确认结果后，再带入盘面。</p><span class="text-link">取数与校时 <Icon name="arrow-up-right" /></span></div><FeatureVisual kind="input" /></a>
   <a class="portal-type-feature" href="/#exhibit-flight"><div class="transformation-glyphs" aria-hidden="true"><span>禄</span><span>权</span><span>科</span><span>忌</span></div><h3>飞宫与自化</h3><p>把星曜与宫位的联系看清。</p><Icon name="arrow-up-right" /></a>
   <a class="portal-file-feature" href="/features/#draft"><div class="portal-file-tags" aria-hidden="true"><span>.ziwei</span><span>.png</span></div><h3>草稿与图片，各有所用。</h3><p>继续编辑，或导出分享。</p><Icon name="arrow-up-right" /></a>
  </div></section>
  <section class="portal-directory wrap"><h2>一眼了解知几。</h2><div class="portal-feature-list">{productFeatures.map(feature=><a href={`/features/#${feature.id}`}><h3>{feature.title}</h3><p>{feature.items[0]}</p><Icon name="arrow-right" /></a>)}</div></section>
  <section class="portal-learn wrap"><div><h2>从第一次使用，<br />到形成自己的习惯。</h2><p>操作指南按具体任务组织，<br />需要哪一步，就从哪一步读起。</p></div><div class="learn-links"><a href="/guide/#start"><span>开始排盘</span><small>选择参数、取数与确认</small><Icon name="arrow-up-right" /></a><a href="/guide/#save"><span>保存与打开</span><small>草稿、另存为与最近文件</small><Icon name="arrow-up-right" /></a><a href="/guide/#shortcuts"><span>键盘操作</span><small>macOS、Windows 与 Linux</small><Icon name="arrow-up-right" /></a><a href="/guide/#help"><span>更新与排查</span><small>版本、帮助与诊断日志</small><Icon name="arrow-up-right" /></a></div></section>
  <section class="portal-release wrap"><div><h2>获取知几。</h2><p data-release-summary role="status" aria-live="polite">查看版本与平台信息</p></div><div><a class="action" href="/download/">前往下载中心 <Icon name="arrow-down" /></a><a class="text-link" href="https://github.com/matharts/zhiji/releases">版本记录 <Icon name="arrow-up-right" /></a></div></section>
  <section class="portal-support wrap"><article><h3>在应用内查帮助</h3><p>使用说明与快捷键可以离线阅读。</p></article><article><h3>遇到问题</h3><p>复制环境信息，附上复现步骤后反馈。</p><a class="text-link" href="https://github.com/matharts/zhiji/issues">反馈问题 <Icon name="arrow-up-right" /></a></article><article><h3>查看源码</h3><p>构建说明、版本记录和开发进展。</p><a class="text-link" href="https://github.com/matharts/zhiji">项目仓库 <Icon name="arrow-up-right" /></a></article></section>
 </main><script>import '../scripts/home.ts'; import '../scripts/experience.ts';</script>
</BaseLayout>
