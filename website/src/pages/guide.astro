---
import ProductLayout from '../layouts/ProductLayout.astro';
import Icon from '../components/Icon.astro';
import { guideTopics, shortcuts } from '../data/product.ts';
import '../styles/product-documents.css';
---
<ProductLayout title="使用指南 — 知几" description="按任务查阅知几的排盘、飞化、标注、草稿、导出和快捷键操作。">
  <main id="main" class="product-document product-wrap guide-document">
    <header class="document-title">
      <h1>使用指南</h1>
      <p>在应用的「设置 → 关于 → 使用帮助」，也可以离线读到操作说明和当前系统的快捷键。</p>
    </header>
    <div class="document-layout">
      <nav class="document-nav" aria-label="指南目录">
        {guideTopics.map(topic => <a href={`#${topic.id}`}>{topic.title}</a>)}
        <a href="#shortcuts">键盘快捷键</a>
      </nav>
      <div class="document-content guide-sheets">
        {guideTopics.map(topic => (
          <section id={topic.id} class="guide-topic" aria-labelledby={`${topic.id}-title`}>
            <h2 id={`${topic.id}-title`}>{topic.title}</h2>
            <p>{topic.intro}</p>
            <ol>{topic.steps.map(step => <li>{step}</li>)}</ol>
            {topic.note && <p class="guide-aside">{topic.note}</p>}
            {topic.link && <a class="product-link" href={`https://github.com/matharts/zhiji/blob/main/${topic.link}`}>{topic.linkLabel} <Icon name="arrow-up-right" /></a>}
          </section>
        ))}
        <section id="shortcuts" class="guide-topic" aria-labelledby="shortcuts-title">
          <h2 id="shortcuts-title">键盘快捷键</h2>
          <p>弹窗或文字编辑中，按键优先作用于当前操作。</p>
          <table class="guide-keys">
            <thead><tr><th scope="col">操作</th><th scope="col">macOS</th><th scope="col">Windows / Linux</th></tr></thead>
            <tbody>{shortcuts.map(item => (
              <tr><th scope="row">{item.action}</th><td>{item.mac.map(key => <kbd>{key}</kbd>)}</td><td>{item.other.map(key => <kbd>{key}</kbd>)}</td></tr>
            ))}</tbody>
          </table>
        </section>
      </div>
    </div>
  </main>
</ProductLayout>
