---
import BaseLayout from '../layouts/BaseLayout.astro';
import SceneHero from '../components/site/SceneHero.astro';
import FeatureVisual from '../components/site/FeatureVisual.astro';
import FlightDemo from '../components/site/FlightDemo.astro';
import ShortcutPanel from '../components/site/ShortcutPanel.astro';
import DownloadClose from '../components/site/DownloadClose.astro';
import Icon from '../components/Icon.astro';
import { productFeatures } from '../data/product.ts';
const exhibit = [
 {feature:productFeatures[0],visual:'input'},
 {feature:productFeatures[1],visual:'chart'},
 {feature:productFeatures[2],visual:'flight'},
 {feature:productFeatures[3],visual:'annotation'},
 {feature:productFeatures[4],visual:'files'},
 {feature:productFeatures[6],visual:'settings'},
] as const;
---
<BaseLayout title="知几 — 紫微斗数产品展厅" description="探索知几的取数、盘面、四化、标注与草稿工作流。为专业命理师与研习者打造的桌面应用。">
 <main id="main" class="exhibition-page">
  <SceneHero />
  <section class="exhibit-section wrap" id="exhibit" aria-labelledby="exhibit-title">
   <div class="section-intro"><h2 id="exhibit-title">打开知几的<br />每一种可能。</h2><p>选择一个主题，走进工具的细节。<br />所有演示均使用固定示例。</p></div>
   <div class="exhibit-shell" data-exhibit>
    <div class="exhibit-tabs" role="tablist" aria-label="产品演示主题" hidden>{exhibit.map(({feature},index)=><button type="button" id={`tab-${feature.id}`} role="tab" aria-controls={`exhibit-${feature.id}`} aria-selected={index===0} tabindex={index===0?0:-1} data-exhibit-tab={feature.id}><span>{feature.title}</span><Icon name="arrow-up-right" /></button>)}</div>
    <div class="exhibit-content">{exhibit.map(({feature,visual})=><section id={`exhibit-${feature.id}`} data-exhibit-panel={feature.id} aria-labelledby={`heading-${feature.id}`}><div class="exhibit-heading"><div><h3 id={`heading-${feature.id}`}>{feature.title}</h3><p>{feature.summary}</p></div><a class="text-link" href={`/guide/#${feature.guide}`}>使用方法 <Icon name="arrow-up-right" /></a></div>{visual==='flight'?<FlightDemo />:<FeatureVisual kind={visual} />}<ul class="exhibit-facts">{feature.items.map(item=><li>{item}</li>)}</ul></section>)}</div>
   </div>
  </section>
  <section class="use-cases wrap" aria-labelledby="cases-title"><h2 id="cases-title">不止于排出一张盘。</h2><div class="use-case-grid"><article><span class="case-word" aria-hidden="true">研</span><h3>个人研习</h3><p>改变参数、观察四化，在同一张盘上反复推敲。</p><a href="/#exhibit-flight">探索飞化 <Icon name="arrow-right" /></a></article><article><span class="case-word" aria-hidden="true">记</span><h3>整理判断</h3><p>用线条、形状与文字，保留观察时的重点。</p><a href="/#exhibit-annotation">查看标注 <Icon name="arrow-right" /></a></article><article><span class="case-word" aria-hidden="true">传</span><h3>交流分享</h3><p>保存可编辑的草稿，导出便于交流的盘面图片。</p><a href="/features/#export">了解导出 <Icon name="arrow-right" /></a></article></div></section>
  <section class="desk-section wrap"><div class="desk-copy"><h2>桌面工具，<br />也照顾操作习惯。</h2><p>常用动作不用反复寻找。<br />键盘、窗口布局与显示设置，接续熟悉的工作节奏。</p><a class="text-link" href="/guide/#shortcuts">全部快捷键 <Icon name="arrow-up-right" /></a></div><ShortcutPanel /></section>
  <section class="capability-directory wrap" aria-labelledby="directory-title"><div class="directory-heading"><h2 id="directory-title">一套完整的工具。</h2><a class="text-link" href="/features/">功能总览 <Icon name="arrow-right" /></a></div><div class="capability-links">{productFeatures.map(feature=><a href={`/features/#${feature.id}`}><h3>{feature.title}</h3><span>{feature.summary}</span><Icon name="arrow-up-right" /></a>)}</div></section>
  <section class="guide-entry wrap"><h2>第一次使用？<br />从一张命盘开始。</h2><div><p>了解取数、飞化、保存与导出的完整操作。<br />也可以在桌面应用内离线查看使用帮助。</p><a class="action" href="/guide/">打开使用指南 <Icon name="arrow-right" /></a></div></section>
  <DownloadClose />
 </main>
 <script>import '../scripts/home.ts'; import '../scripts/experience.ts';</script>
</BaseLayout>
