---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import '../styles/download-page.css';
const repository = 'https://github.com/matharts/zhiji';
// 安装格式只描述已有发布协议；是否可下载始终由实际发布结果决定。
const platforms = [
 { id: 'macos', name: 'macOS', description: '在 Mac 上使用知几', format: '应用归档包 · .app.tar.gz', icon: 'M17 4H7a2 2 0 0 0-2 2v11h14V6a2 2 0 0 0-2-2ZM3 20h18M9 17v3m6-3v3' },
 { id: 'windows', name: 'Windows', description: '适用于 Windows 桌面', format: 'NSIS 安装程序 · .exe', icon: 'M3 4h8v7H3ZM14 4h7v7h-7ZM3 14h8v7H3ZM14 14h7v7h-7Z' },
 { id: 'linux', name: 'Linux', description: '在 Linux 桌面运行', format: 'AppImage · DEB', icon: 'M4 5h16v14H4ZM7 9l3 3-3 3m5 0h5' },
];
---
<BaseLayout title="下载知几 — macOS、Windows 与 Linux" description="获取知几桌面安装包，查看最新正式版本、安装说明与项目源码。">
 <main id="main" class="download-main download-page wrap">
  <a class="back-link" href="/"><Icon name="arrow-left" />返回产品首页</a>
  <div class="download-intro"><div><h1>下载知几</h1><p>紫微斗数专业排盘软件。</p></div><img src="/images/app.png" width="88" height="88" alt="" /></div>
  <div class="download-workspace">
   <div class="download-platforms" role="group" aria-label="选择操作系统" data-platform-picker hidden>{platforms.map(platform=><button type="button" data-select-platform={platform.id} aria-pressed="false" aria-controls={`download-${platform.id}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={platform.icon}/></svg>{platform.name}</button>)}</div>
   <div class="platform-grid">{platforms.map(platform=><section class="platform-card" data-platform={platform.id} id={`download-${platform.id}`} aria-labelledby={`platform-${platform.id}`}>
    <div class="platform-identity"><svg class="platform-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={platform.icon} /></svg><h2 id={`platform-${platform.id}`}>{platform.name}</h2><p>{platform.description}</p><span class="platform-format">{platform.format}</span></div>
    <div class="platform-packages"><h3>安装包</h3><div data-assets aria-live="polite"><a class="asset-fallback" href={`${repository}/releases`}>前往 GitHub 发布页</a></div><a class="package-release-link" href={`${repository}/releases`}>查看发布说明 <Icon name="arrow-up-right" /></a></div>
   </section>)}</div>
   <div class="release-status"><p data-release-status role="status" aria-live="polite">请查看 GitHub 发布页获取最新版本信息。</p><button type="button" data-release-retry hidden>重新查询 <Icon name="replay" /></button></div>
  </div>
  <p class="platform-note">可用安装包、支持架构与系统要求以实际发布版本为准。</p>
  <div class="download-support" id="installation"><section aria-labelledby="installation-title"><h2 id="installation-title">安装与使用</h2><details><summary>如何选择安装包？<Icon name="chevron-down" /></summary><p>选择与你的系统和处理器架构对应的安装包；具体架构标记与安装步骤请查看该版本的发布说明。</p></details><details><summary>没有找到对应版本？<Icon name="chevron-down" /></summary><p>某个平台可能尚未提供安装包。可前往发布页查看已有版本，或参考项目文档从源码构建。</p></details><details><summary>第一次使用知几？<Icon name="chevron-down" /></summary><p>使用指南介绍起盘、四化、标注和草稿操作。<a class="asset-fallback" href="/guide/">打开使用指南</a></p></details></section><section class="download-source" aria-labelledby="source-title"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m11 9-7 7 7 7m10-14 7 7-7 7M18 5l-4 22"/></svg><h2 id="source-title">从源码开始</h2><p>构建步骤、发布说明和问题反馈，都在项目仓库。</p><a class="text-link" href={repository}>查看 GitHub 项目 <Icon name="arrow-up-right" /></a></section></div>
 </main>
 <script>import '../scripts/download.ts';</script>
</BaseLayout>
