---
import ProductLayout from '../layouts/ProductLayout.astro';
import Icon from '../components/Icon.astro';
import '../styles/product-documents.css';

const repository = 'https://github.com/matharts/zhiji';
// 发布可能缺少部分平台；格式与实际包列表分别呈现。
const platforms = [
  { id: 'macos', name: 'macOS', format: '.app.tar.gz', instructions: '解压应用归档包，将知几移到「应用程序」。' },
  { id: 'windows', name: 'Windows', format: '.exe', instructions: '运行 NSIS 安装程序，按提示完成安装。' },
  { id: 'linux', name: 'Linux', format: 'AppImage / DEB', instructions: '选择 AppImage，或用系统包管理器安装 DEB。' },
];
---
<ProductLayout title="版本与下载 — 知几" description="查看知几正式版发布状态、安装包和项目源码。">
  <main id="main" class="product-document product-wrap download-document">
    <header class="document-title download-heading">
      <h1>版本与下载</h1>
      <div>
        <p>紫微斗数专业排盘软件</p>
        <a class="product-link" href={`${repository}/blob/main/CONTRIBUTING.md`}>从源码构建 <Icon name="arrow-up-right" /></a>
      </div>
    </header>
    <section class="install-section" aria-labelledby="install-title">
      <header class="install-header">
        <div>
          <h2 id="install-title" data-install-title>发布状态</h2>
          <p data-release-status role="status">版本信息见 GitHub。</p>
        </div>
        <button type="button" class="install-retry" data-release-retry hidden>重新查询 <Icon name="replay" /></button>
      </header>
      <div data-install-options hidden>
        <div class="install-platforms" role="group" aria-label="选择操作系统">
          {platforms.map(platform => <button type="button" data-select-platform={platform.id} aria-pressed="false" aria-controls={`download-${platform.id}`} hidden>{platform.name}</button>)}
        </div>
        <div class="install-panels">{platforms.map(platform => (
          <section class="install-panel" data-platform={platform.id} id={`download-${platform.id}`} aria-labelledby={`platform-${platform.id}`} hidden>
            <div class="install-format">
              <h3 id={`platform-${platform.id}`}>{platform.name}</h3>
              <code>{platform.format}</code>
              <p>{platform.instructions}</p>
            </div>
            <div class="install-files">
              <h4>安装包</h4>
              <div data-assets></div>
            </div>
          </section>
        ))}</div>
      </div>
      <footer class="install-footer">
        <a class="product-primary" href="/experience/#workspace" data-download-fallback>体验参考盘 <Icon name="arrow-up-right" /></a>
        <p data-download hidden>支持架构和系统要求以对应版本的发布说明为准。</p>
        <a class="product-link" href={`${repository}/releases`}>GitHub 发布页 <Icon name="arrow-up-right" /></a>
      </footer>
    </section>
    <section class="download-help" id="installation" aria-labelledby="download-help-title" data-download hidden>
      <h2 id="download-help-title" class="product-subheading">安装与使用</h2>
      <div>
        <details><summary>如何选择安装包？<Icon name="chevron-down" /></summary><p>选择与你的操作系统和处理器架构一致的安装包。具体架构标记请查看该版本的发布说明。</p></details>
        <details><summary>没有对应的安装包？<Icon name="chevron-down" /></summary><p>可以在 <a href={`${repository}/releases`}>GitHub 发布页</a>查看其他版本，或按照<a href={repository}>仓库说明</a>从源码构建。</p></details>
        <details><summary>安装后从哪里开始？<Icon name="chevron-down" /></summary><p><a href="/guide/#start">使用指南</a>介绍手动设参、公历与农历取数，以及干支反推。应用内也能离线查阅。</p></details>
      </div>
    </section>
  </main>
  <script>import '../scripts/download.ts';</script>
</ProductLayout>
