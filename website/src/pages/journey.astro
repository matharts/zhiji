---
import BaseLayout from '../layouts/BaseLayout.astro';
import SceneHero from '../components/site/SceneHero.astro';
import FeatureVisual from '../components/site/FeatureVisual.astro';
import FlightDemo from '../components/site/FlightDemo.astro';
import ShortcutPanel from '../components/site/ShortcutPanel.astro';
import DownloadClose from '../components/site/DownloadClose.astro';
import Icon from '../components/Icon.astro';
const stages=[['input','取数'],['chart','观盘'],['flight','飞化'],['annotation','标注'],['files','保存']];
---
<BaseLayout title="知几 — 从起盘到研习" description="跟随一次完整的研习流程，了解知几如何连接日期取数、盘面观察、四化飞宫、标注与保存。">
 <main id="main" class="journey-page"><SceneHero mode="journey" />
  <nav class="journey-progress" aria-label="研习流程">{stages.map(([id,label],index)=><a href={`#step-${id}`}><span>{index+1}</span>{label}</a>)}</nav>
  <div class="story wrap">
   <section class="story-chapter" id="step-input"><div class="story-copy"><span class="step-count">第一步</span><h2>从时间出发。</h2><p>资料可能是一段公历日期，也可能是农历或四柱。知几提供不同入口，将确认后的结果带到排盘参数。</p><ul><li>公历、农历、干支反推</li><li>出生地时区与经度</li><li>确认候选后回填</li></ul><a class="text-link" href="/guide/#start">取数操作 <Icon name="arrow-up-right" /></a></div><div class="story-evidence"><FeatureVisual kind="input" /><p class="evidence-note">公历选填出生地时可校正真太阳时；干支反推使用固定北京时间。计算范围以历法说明为准。</p></div></section>
   <section class="story-chapter" id="step-chart"><div class="story-copy"><span class="step-count">第二步</span><h2>先看全局，<br />再看每一宫。</h2><p>十二宫、星曜、大限和流年同盘观察。把不需要的信息收起，把注意力留给当前的问题。</p><ul><li>显示项目按需调整</li><li>单双列布局与侧栏显隐</li><li>界面与命盘简繁体独立设置</li></ul></div><div class="story-evidence"><FeatureVisual kind="chart" /><div class="story-detail"><h3>参数仍在你手里。</h3><p>取数确认后，生年、月份、时辰、紫微位置和命宫等参数仍可手动调整。</p></div></div></section>
   <section class="story-flight" id="step-flight"><div class="story-copy"><span class="step-count">第三步</span><h2>让宫位之间的联系，<br />在眼前展开。</h2><p>点选一个宫位，再切换禄、权、科、忌。下方是可操作的固定命盘示例。</p></div><FlightDemo /><div class="story-triad"><div><h3>宫位出发</h3><p>以选中的宫位为起点。</p></div><div><h3>四化去向</h3><p>查看所落星曜与宫位。</p></div><div><h3>向心与离心</h3><p>桌面应用中可独立筛选自化。</p></div></div></section>
   <section class="story-chapter" id="step-annotation"><div class="story-copy"><span class="step-count">第四步</span><h2>把想法，<br />写回盘面。</h2><p>观察不必只停留在脑海。圈出重点、连接宫位、补充文字，让推敲的过程可以回看。</p><ul><li>线条、箭头、形状与文字</li><li>移动、调整与显隐</li><li>撤销与重做</li></ul></div><div class="story-evidence"><FeatureVisual kind="annotation" /></div></section>
   <section class="story-chapter" id="step-files"><div class="story-copy"><span class="step-count">第五步</span><h2>结束这一轮，<br />留给下一轮。</h2><p>草稿保留可编辑的盘面，图片用于交流与分享。用不同的文件，承接不同的目的。</p><a class="text-link" href="/guide/#save">保存与文件说明 <Icon name="arrow-up-right" /></a></div><div class="story-evidence"><FeatureVisual kind="files" /><p class="evidence-note">草稿保存排盘参数、显示状态与标注；原始日期、出生地和换算过程请另行记录。</p></div></section>
  </div>
  <section class="journey-ending wrap"><div><h2>熟悉之后，<br />操作可以更快。</h2><p>常用文件操作与标注操作都有快捷键。</p><a class="text-link" href="/guide/#shortcuts">查看操作指南 <Icon name="arrow-right" /></a></div><ShortcutPanel /></section>
  <DownloadClose />
 </main><script>import '../scripts/home.ts'; import '../scripts/experience.ts';</script>
</BaseLayout>
