---
import SceneArt from './SceneArt.astro';
import Icon from '../Icon.astro';
interface Props { mode?: 'exhibition' | 'journey' | 'portal'; }
const { mode = 'exhibition' } = Astro.props;
---
<section class:list={['hero','relative','overflow-hidden',`hero-${mode}`]} id="top" aria-labelledby="hero-title">
 <SceneArt />
 <div class="hero-inner wrap relative z-[1] flex h-full items-center">
  <div class="hero-copy">
   {mode==='journey' ? <><h1 id="hero-title">从一张命盘，<br />开始一次研习。</h1><p class="hero-subject">知几 · 紫微斗数桌面软件</p></> : <><h1 id="hero-title">知几<span>Zhiji</span></h1><h2>紫微斗数排盘与研习</h2></>}
   <p>{mode==='portal' ? '你的排盘工具，也是一套完整的研习工作流。' : mode==='journey' ? '取数、观盘、飞化、标注、保存。顺着一次真实的工作过程，认识知几。' : '从时间与地点，到星曜与宫位。为专业命理师与研习者打造的桌面工具。'}</p>
   <div class="hero-actions"><a class="action" href={mode==='journey'?'#step-input':'/download/'}>{mode==='journey'?'开始这次研习':'下载知几'} <Icon name="arrow-down" /></a><a class="text-link" href={mode==='portal'?'/guide/':mode==='journey'?'/download/':'#exhibit'}>{mode==='portal'?'使用指南':mode==='journey'?'下载桌面版':'进入产品展厅'} <Icon name="arrow-right" /></a></div>
   <p class="hero-release" data-release-summary role="status" aria-live="polite">查看版本与平台信息</p>
  </div>
  <div class="hero-meta"><span>天地人三盘 · 飞化示意</span><button class="motion-toggle" type="button" data-motion-toggle hidden><span class="motion-icon" data-motion-icon data-state="playing" aria-hidden="true"><Icon name="pause" class="motion-pause" /><Icon name="play" class="motion-play" /></span><span data-motion-label>暂停动画</span></button></div>
 </div>
</section>
