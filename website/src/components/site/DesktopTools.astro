---
import ProductScenes from './ProductScenes.astro';
import Icon from '../Icon.astro';
import { shortcuts } from '../../data/product.ts';
---
<section class="desktop-tools wrap" aria-labelledby="desktop-tools-title">
 <div class="desktop-tools-heading"><h2 id="desktop-tools-title">留在熟悉的桌面里。</h2><a class="text-link" href="/features/#workspace">外观与工作习惯 <Icon name="arrow-up-right" /></a></div>
 <div class="desktop-tools-grid"><div class="desktop-appearance"><ProductScenes kind="appearance" /></div><div class="desktop-shortcuts"><h3>常用操作，直接按下。</h3><table><caption class="sr-only">macOS 与 Windows/Linux 常用快捷键</caption><thead><tr><th scope="col">操作</th><th scope="col">macOS</th><th scope="col">Windows / Linux</th></tr></thead><tbody>{shortcuts.filter(item=>['新建草稿','保存草稿','导出图片','撤销标注'].includes(item.action)).map(item=><tr><th scope="row">{item.action}</th><td>{item.mac.join(' ')}</td><td>{item.other.join(' + ')}</td></tr>)}</tbody></table><a class="text-link" href="/guide/#shortcuts">全部快捷键 <Icon name="arrow-right" /></a></div></div>
</section>
