---
import Icon from '../Icon.astro';
import ChartThumbnail from './ChartThumbnail.astro';
import { chartExample } from '../../data/chart-example.ts';
import { palaceStems, readingDecadeRanges } from '../../data/flight-example.ts';
interface Props { kind: 'input' | 'time' | 'annotation' | 'files' | 'export' | 'appearance' | 'keyboard'; }
const { kind } = Astro.props;
// 取参考盘左下角的相邻四宫，让自由标注始终落在真实宫位上下文中。
const annotationCells = (['卯','寅','丑','子'] as const).map(branch => chartExample.cells.find(cell => cell?.branch === branch)!);
---
{kind === 'input' && <div class="date-scene" data-date-scene>
  <div class="mini-window">
    <div class="mini-title"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>日期取数</span><span class="sample-label">界面示意</span></div>
    <div class="segmented" role="group" aria-label="预览取数入口" data-date-modes hidden>{['公历', '农历', '干支反推'].map((label, index) => <button type="button" aria-pressed={index === 0} data-date-mode={index}>{label}</button>)}</div>
    <div class="date-fields" data-date-fields><div><small>年</small><strong>2000</strong></div><div><small>月</small><strong>06</strong></div><div><small>日</small><strong>15</strong></div></div>
    <div class="date-time"><span>出生时间</span><strong>10 : 30</strong></div>
    <div class="date-result" role="status" data-date-result>公历日期 · 结合出生地校时</div>
  </div>
  <span class="scene-caption">入口预览，不执行日期计算</span>
</div>}
{kind === 'time' && <div class="time-scene" aria-label="时区、经度与真太阳时的校正流程示意">
  <div class="longitude-globe" aria-hidden="true"><div class="globe-ring ring-one"></div><div class="globe-ring ring-two"></div><div class="globe-ring ring-three"></div><div class="globe-equator"></div><span class="globe-point"></span><div class="sun-orbit"><i></i></div></div>
  <div class="time-badges"><span>时区</span><span>经度</span><span>真太阳时</span></div>
  <div class="time-route"><span>出生地</span><Icon name="arrow-right" /><strong>校正时间</strong><Icon name="arrow-right" /><span>确认回填</span></div>
</div>}
{kind === 'annotation' && <div class="annotation-scene" data-annotation-scene>
  <div class="annotation-paper marking-chart">
    <div class="annotation-board">{annotationCells.map((cell,index)=><div class:list={['annotated-palace',{'annotated-origin':cell.branch===chartExample.origin}]} style={`grid-column:${index===0?1:index};grid-row:${index===0?1:2}`}><div class="paper-heading"><span>{cell.palace}</span><span>{palaceStems[cell.branch]}{cell.branch}</span></div><div class="paper-stars"><strong>{cell.stars.join('　')}</strong>{readingDecadeRanges[cell.branch]&&<span>大限 {readingDecadeRanges[cell.branch]!.join('–')} 岁</span>}</div></div>)}</div>
    <svg viewBox="0 0 600 360" fill="none" preserveAspectRatio="none" aria-hidden="true"><ellipse data-mark="circle" cx="100" cy="270" rx="66" ry="28" transform="rotate(-9 100 270)" /><path data-mark="arrow" d="M164 263C240 249 220 112 316 105m-17-8 17 8-15 13" /></svg>
    <span class="paper-note" data-mark="text">留意此宫</span>
  </div>
  <div class="mark-toolbar" role="group" aria-label="预览标注工具" data-mark-tools hidden>
    <button type="button" data-mark-toggle="circle" aria-pressed="true" aria-label="显示圆圈标注"><svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="12" rx="8" ry="7" /></svg></button>
    <button type="button" data-mark-toggle="arrow" aria-pressed="true" aria-label="显示箭头标注"><Icon name="arrow-up-right" /></button>
    <button type="button" data-mark-toggle="text" aria-pressed="true" aria-label="显示文字标注">T</button>
    <span class="toolbar-divider"></span><span class="ink-dot" aria-hidden="true"></span>
    <button type="button" data-replay-marks hidden aria-label="重播标注"><Icon name="replay" /></button>
  </div>
  <span class="scene-caption">甲子年固定示例 · 标注效果示意</span>
</div>}
{kind === 'files' && <div class="file-scene" aria-label="草稿保留命盘参数、显示状态及标注">
  <div class="draft-sheet sheet-back" aria-hidden="true"></div><div class="draft-sheet sheet-front"><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M7 7h34v34H7zM7 15h34M7 33h34M15 7v34M33 7v34" stroke="currentColor" stroke-width="1.3"/></svg><strong>.ziwei</strong><span>知几草稿</span></div>
  <div class="file-check"><span>✓</span> 命盘、显示与标注</div>
</div>}
{kind === 'export' && <div class="export-scene" data-export-scene data-scale="2">
  <div class="export-stack" aria-hidden="true"><div></div><div></div><div><span>PNG</span><ChartThumbnail /><strong data-export-factor>2×</strong></div></div>
  <div class="segmented export-scale" role="group" aria-label="预览图片导出倍率" data-export-controls hidden>{[1,2,3].map(scale=><button type="button" aria-pressed={scale===2} data-export-scale={scale}>{scale}×</button>)}</div>
  <span class="scene-caption">倍率效果示意 · 复制图片固定为 2×</span>
</div>}
{kind === 'appearance' && <div class="appearance-scene" data-appearance="dark">
  <div class="appearance-preview"><header><span>知几</span><span>显示设置</span></header><div class="appearance-content"><div class="appearance-palace"><span>命宫　丙寅</span><strong>贪狼</strong><small>6–15</small></div><div class="appearance-options"><span>星曜 <i></i></span><span>大限 <i></i></span><span>流年 <i></i></span></div></div></div>
  <div class="segmented" role="group" aria-label="预览盘面外观" data-appearance-controls hidden><button type="button" data-appearance-mode="dark" aria-pressed="true">夜晚</button><button type="button" data-appearance-mode="light" aria-pressed="false">日间</button></div>
</div>}
{kind === 'keyboard' && <div class="keyboard-scene" data-keyboard-scene>
  <div class="key-pair" aria-hidden="true"><kbd>⌘</kbd><kbd data-key-letter>S</kbd></div>
  <div class="key-actions" role="group" aria-label="查看 macOS 快捷键" data-key-controls hidden><button type="button" data-key="N" aria-pressed="false">新建</button><button type="button" data-key="S" aria-pressed="true">保存</button><button type="button" data-key="Z" aria-pressed="false">撤销</button></div>
  <span class="scene-caption" data-key-caption role="status">保存草稿 · ⌘ S</span>
</div>}
