---
import Icon from '../Icon.astro';
import ChartThumbnail from './ChartThumbnail.astro';
import { chartExample } from '../../data/chart-example';
// 六种能力使用不同的界面示意；固定样例与真实应用能力分别表达。
const abilities = [
 {name:'调整盘面',title:'盘面显示',detail:'星曜、大限与流年，按需显示。',link:'/guide/#view'},
 {name:'观察自化',title:'飞化显示',detail:'生年四化、飞宫四化与自化，独立筛选。',link:'/features/#flight'},
 {name:'继续草稿',title:'草稿与文件',detail:'命盘、显示和标注，随草稿一起保留。',link:'/guide/#save'},
 {name:'导出图片',title:'图片与分享',detail:'PNG 支持 1×、2×、3×；复制图片固定为 2×。',link:'/guide/#export'},
 {name:'记忆布局',title:'桌面工作区',detail:'恢复上次的窗口尺寸、位置与布局。',link:'/features/#workspace'},
 {name:'离线查阅帮助',title:'帮助与支持',detail:'在应用内查阅使用帮助和当前平台的快捷键。',link:'/guide/#help'},
];
---
<section class="ray-abilities wrap" aria-labelledby="ability-title" data-abilities>
 <div class="ability-copy">
  <h2 id="ability-title">知几，还能做什么？</h2>
  <div class="ability-words" role="group" aria-label="切换功能预览">{abilities.map((ability,index)=><button type="button" disabled data-ability={index} data-ability-href={ability.link} aria-pressed={index===0} aria-controls={`ability-panel-${index}`}>{ability.name}。</button>)}<a href="/features/">以及更多。</a></div>
  <a class="ability-more" href={abilities[0].link} data-ability-link>查看使用说明 <Icon name="arrow-up-right" /></a>
 </div>
 <div class="ability-stage">
  {abilities.map((ability,index)=><section class="ability-preview" id={`ability-panel-${index}`} data-ability-panel={index} hidden={index!==0} aria-label={`${ability.name}功能示意`}>
   <header class="ability-preview-title"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{ability.title}</span><small>功能示意</small></header>
   <div class="ability-art">
    {index===0 && <div class="display-preview">
     <div class="preview-chart" aria-label="甲子年固定示例">{chartExample.cells.map(cell=><div class:list={['preview-cell',{'is-origin':cell?.branch===chartExample.origin,'is-empty':!cell}]}>{cell&&<><span>{cell.palace} · {cell.branch}</span><strong>{cell.stars.slice(0,2).join(' ')}</strong></>}</div>)}</div>
     <div class="preview-inspector"><span>显示</span>{['星曜','大限','流年'].map(label=><div><span>{label}</span><i aria-hidden="true"></i></div>)}<div class="preview-language">简体 / 繁体</div></div>
    </div>}
    {index===1 && <div class="transformation-preview">
     <div class="transformation-kinds" aria-label="四化显示">{['禄','权','科','忌'].map(kind=><span>{kind}</span>)}</div>
     <div class="transformation-options">{['生年四化','飞宫四化','向心自化','离心自化'].map(label=><div><span>{label}</span><i aria-hidden="true"></i></div>)}</div>
    </div>}
    {index===2 && <div class="files-preview"><div class="file-location"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 6h7l2 3h9v11H3z"/></svg>最近草稿</div>{['当前草稿.ziwei','另存草稿.ziwei'].map((name,i)=><div class:list={['preview-file',{'is-selected':i===0}]}><svg viewBox="0 0 32 36" fill="none" stroke="currentColor" aria-hidden="true"><path d="M5 2h15l7 7v25H5zM20 2v8h7M10 17h12M10 23h12"/></svg><div><strong>{name}</strong><span>命盘 · 显示 · 标注</span></div><span>.ziwei</span></div>)}<div class="file-commands"><span>打开最近</span><span>另存为</span></div></div>}
    {index===3 && <div class="image-preview" data-image-preview data-scale="2"><div class="image-sheets"><div></div><div></div><div><span>PNG</span><ChartThumbnail /><strong data-image-factor>2×</strong></div></div><div class="preview-scales" role="group" aria-label="预览导出倍率">{[1,2,3].map(scale=><button type="button" disabled data-image-scale={scale} aria-pressed={scale===2}>{scale}×</button>)}</div></div>}
    {index===4 && <div class="desktop-preview" data-desktop-preview data-layout="single"><div class="desktop-window"><div class="desktop-title"><img src="/images/app.ico" width="16" height="16" alt=""/><span>知几</span></div><div class="desktop-content"><div class="desktop-chart"><ChartThumbnail /></div><div class="desktop-sidebar">{['排盘参数','显示设置','外观与布局','图片导出'].map(label=><span>{label}<i></i></span>)}</div></div></div><div class="preview-scales" role="group" aria-label="预览侧栏布局"><button type="button" disabled data-preview-layout="single" aria-pressed="true">单列</button><button type="button" disabled data-preview-layout="double" aria-pressed="false">双列</button></div></div>}
    {index===5 && <div class="help-preview"><div class="help-preview-nav"><span>使用帮助</span><a href="/guide/#shortcuts">快捷键</a></div><h3>从一张命盘开始</h3>{[{name:'日期取数与校时',href:'start'},{name:'飞宫四化与自化',href:'view'},{name:'盘面标注',href:'annotate'},{name:'保存与导出',href:'save'}].map(item=><a href={`/guide/#${item.href}`}>{item.name}<Icon name="arrow-right" /></a>)}</div>}
   </div>
   <p class="ability-detail">{ability.detail}</p>
  </section>)}
 </div>
</section>
