---
import Icon from '../Icon.astro';
// 回答首次下载前的实际问题，能力与文件范围以当前产品说明为准。
const questions = [
 {question:'支持哪些操作系统？',answer:'知几面向 macOS、Windows 和 Linux 桌面。可用安装包、支持架构及系统要求，以实际发布版本为准。'},
 {question:'官网里的命盘可以直接用于排盘吗？',answer:'官网展示的是固定参考盘，用于体验宫位选择、四化落点和标注效果。实际排盘、日期取数和校时请使用桌面软件。'},
 {question:'图片与草稿有什么区别？',answer:'PNG 用于查看和分享；.ziwei 草稿保留命盘参数、显示状态与标注，可重新打开继续编辑。'},
 {question:'原始日期和出生地会保存在草稿里吗？',answer:'草稿保留换算后的排盘参数，原始日期、出生地与换算过程不写入草稿。需要留存这些资料时，请另行记录。'},
 {question:'如何核对取数与校时规则？',answer:'公历出生地可选；未选择时按固定北京时间取数。干支反推不应用出生地或真太阳时修正。',href:'/guide/#start',label:'查看计算口径与支持范围'},
 {question:'可以查看软件源码吗？',answer:'项目以 MIT 许可证开放源码，构建说明与许可证可在项目仓库查看。',href:'https://github.com/matharts/zhiji/blob/main/LICENSE',label:'查看许可证'},
];
---
<section class="home-questions wrap" aria-labelledby="questions-title">
 <div><h2 id="questions-title">开始使用前</h2><a class="text-link" href="/guide/">查看完整指南 <Icon name="arrow-up-right" /></a></div>
 <div class="home-question-list">{questions.map(item=><details><summary>{item.question}<Icon name="chevron-down" /></summary><p>{item.answer}{item.href&&<> <a href={item.href}>{item.label} <Icon name="arrow-up-right" /></a></>}</p></details>)}</div>
</section>
