---
import Icon from '../Icon.astro';
import { palaceStems, selfTransformationExample } from '../../data/flight-example.ts';
// 自化星曜与四化类别来自独立参考样例，不在官网计算新的命盘。
const example = selfTransformationExample;
---
<section class="self-story wrap" aria-labelledby="self-story-title" data-self-story>
 <div class="self-diagram" id="self-transformations">
  <div class="self-controls" role="group" aria-label="筛选自化向性"><button type="button" disabled data-self-direction="inward" aria-pressed="true">向心</button><button type="button" disabled data-self-direction="outward" aria-pressed="true">离心</button><button type="button" disabled data-self-direction="all" aria-pressed="true">全部</button></div>
  <div class="self-diagram-art" aria-hidden="true"><div class="self-palace"><div><span>{example.palace}</span><span>{palaceStems[example.branch]}{example.branch}</span></div><strong>{example.star}</strong><small>天机</small></div>
   <svg viewBox="0 0 600 320" fill="none"><defs><marker id="self-story-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M1 1 9 5 1 9" stroke="currentColor" stroke-width="1.4"/></marker></defs>
    <g class="self-inward" data-self-mark="inward"><path data-self-path pathLength="1" d="M40 224C110 224 130 192 255 192" marker-end="url(#self-story-arrow)"/><circle cx="111" cy="214" r="17"/><text x="111" y="220">{example.inward}</text><text class="self-direction-label" x="70" y="269">向心</text></g>
    <g class="self-outward" data-self-mark="outward"><path data-self-path pathLength="1" d="M340 150C420 150 427 96 550 96" marker-end="url(#self-story-arrow)"/><circle cx="480" cy="108" r="17"/><text x="480" y="114">{example.outward}</text><text class="self-direction-label" x="517" y="55">离心</text></g>
   </svg>
  </div>
  <p class="self-example">甲子年固定示例 · {example.branch}宫{example.star}</p>
 </div>
 <div class="self-story-copy"><h2 id="self-story-title">向心与离心，<br />独立显示。</h2><p>保留同一张命盘，<br />切换你要观察的自化方向。</p>
  <dl><div><dt>向心自化</dt><dd>{example.star}化{example.inward}</dd></div><div><dt>离心自化</dt><dd>{example.star}化{example.outward}</dd></div></dl>
  <p class="self-filter-status" data-self-status role="status">向心与离心同时显示</p>
  <a class="text-link" href="/features/#flight">了解飞宫与自化 <Icon name="arrow-up-right" /></a>
 </div>
</section>
