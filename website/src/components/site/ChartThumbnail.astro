---
import { chartExample } from '../../data/chart-example.ts';
// 缩略图直接使用同一固定参考盘，十二宫位置与星曜不再由通用网格代替。
---
<svg viewBox="0 0 120 120" fill="none" aria-hidden="true" class="chart-thumbnail">
 {chartExample.cells.map((cell,index)=>cell&&<g>
  <rect x={(index%4)*30+1} y={Math.floor(index/4)*30+1} width="28" height="28" stroke="currentColor" stroke-opacity=".48" stroke-width=".65" />
  <text x={(index%4)*30+4} y={Math.floor(index/4)*30+8} fill="currentColor" opacity=".7" font-size="4">{cell.palace}</text>
  <text x={(index%4)*30+4} y={Math.floor(index/4)*30+18} fill="currentColor" font-size="4.5">{cell.stars.slice(0,2).join(' ')}</text>
 </g>)}
 <text x="60" y="63" text-anchor="middle" fill="currentColor" font-size="10">{chartExample.year}</text>
</svg>
