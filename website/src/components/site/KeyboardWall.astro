---
const rows = [['esc','F1','F2','F3','F4','F5','F6','F7'],['~','1','2','3','4','5','6','7'],['tab','Q','W','E','R','T','Y','U'],['⇧','Z','X','C','V','B','N','M'],['fn','⌃','⌥','⌘','space','⌘','⌥']];
const commands = [{key:'⌘ N',title:'新建',text:'从一张空白草稿开始。'},{key:'⌘ S',title:'保存',text:'留下当前盘面与标注。'},{key:'⌘ Z',title:'撤销',text:'退回上一次标注操作。'},{key:'⇧ ⌘ E',title:'导出',text:'把盘面带出工作区。'}];
---
<section class="ray-keyboard wrap" aria-labelledby="keyboard-title">
 <div class="ray-keyboard-copy"><h2 id="keyboard-title">常用操作，<br />交给熟悉的按键。</h2><p>把注意力留给命盘。<br />让操作跟上推演的节奏。</p><a class="action" href="/guide/#shortcuts">查看快捷键</a><span data-keywall-status role="status">macOS 快捷键预览</span></div>
 <div class="keywall"><div class="keywall-rows" aria-hidden="true">{rows.map(row=><div>{row.map(key=><span>{key}</span>)}</div>)}</div><div class="keywall-actions" role="group" aria-label="预览 macOS 常用快捷键">{commands.map(command=><button type="button" data-keywall={command.key} disabled aria-pressed="false"><span>{command.key}</span><p><strong>{command.title}。</strong>{command.text}</p></button>)}</div></div>
</section>
