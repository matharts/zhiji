---
import Icon from './Icon.astro';
const links = [
  { href: '/features/', label: '功能总览' },
  { href: '/#exhibit-flight', label: '在线体验' },
  { href: '/guide/', label: '使用指南' },
  { href: 'https://github.com/matharts/zhiji/releases', label: '版本记录' },
];
---
<header class="site-header fixed inset-x-0 top-0 z-50">
 <div class="site-header-inner wrap flex items-center">
  <a class="brand inline-flex items-center whitespace-nowrap" href="/" aria-label="知几，返回首页">
    <span>知几</span>
  </a>
  <nav class="main-nav hidden items-center min-[701px]:flex" aria-label="主导航">
    {links.map((link, index) => <a class:list={{ 'nav-secondary': index === links.length - 1 }} href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.label}{index === links.length - 1 && <Icon name="arrow-up-right" />}</a>)}
  </nav>
  <a class="nav-action inline-flex items-center justify-center whitespace-nowrap" href="/download/" aria-current={Astro.url.pathname === '/download/' ? 'page' : undefined}>下载知几 <Icon name="arrow-down" /></a>
  <details class="mobile-menu relative block min-[701px]:hidden">
    <summary aria-label="打开导航菜单" aria-controls="mobile-navigation"><span>菜单</span><Icon name="menu" class="menu-open" /><Icon name="close" class="menu-close" /></summary>
    <div class="mobile-menu-backdrop" aria-hidden="true"></div>
    <nav id="mobile-navigation" class="mobile-menu-panel" aria-label="移动导航">
      {links.map((link, index) => <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}><span>{link.label}</span><Icon name={index === links.length - 1 ? 'arrow-up-right' : 'arrow-right'} /></a>)}
    </nav>
  </details>
 </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    // 越过顶部阈值后切换导航背景，与当前滚动位置同步。
    const syncHeader = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
    window.addEventListener('scroll', syncHeader, { passive: true });
    syncHeader();
  }
  const menu = document.querySelector('.mobile-menu');
  if (menu instanceof HTMLDetailsElement) {
    // 原生 details 管理展开；按钮名称、读屏状态与实际开合保持一致。
    const syncMenu = () => {
      const summary = menu.querySelector('summary');
      summary?.setAttribute('aria-label', menu.open ? '关闭导航菜单' : '打开导航菜单');
      summary?.setAttribute('aria-expanded', String(menu.open));
    };
    menu.addEventListener('toggle', syncMenu);
    syncMenu();
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a, .mobile-menu-backdrop')) menu.open = false;
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    // 焦点离开菜单或切回桌面宽度时收起，避免保留不可见的展开状态。
    menu.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
    });
    window.matchMedia('(min-width: 701px)').addEventListener('change', (event) => {
      if (event.matches) menu.open = false;
    });
  }
</script>
